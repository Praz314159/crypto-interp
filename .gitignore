# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Build artifacts
build/
dist/

# Notes / manuscript — kept on disk only, not in git
notes/

# Research artifacts — hypotheses, findings, agenda; disk-only
research_directions.md
experiments/*/README.md

# Measure results cached in the reference run when the docs are followed in place
tests/fixtures/*/measures/

# Experiment outputs — regenerable, can be large
experiments/*/runs/
experiments/*/datasets/
experiments/*/figures/
experiments/*/data/

# Analysis outputs — regenerable figures/CSVs/npz, organized as
# outputs/<analysis>/<experiment-id-or-"all">/
outputs/

# Background-task / debug logs
*.log

# Reference material (PDFs, notebooks) — external sources, kept on disk only
papers/
*.ipynb

# Local config
.env

# Personal learning exercises — not project code
scratch/
